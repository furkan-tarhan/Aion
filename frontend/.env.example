# Lokal geliştirme (next dev, docker olmadan): boş bırakılırsa http://localhost:5000 kullanılır
# Docker Compose (Nginx reverse proxy arkasında): "" olarak ayarlanır, /api relative path'e gider
NEXT_PUBLIC_API_URL=

# generateMetadata / sitemap.ts gibi server component'lerin backend'e eriştiği adres.
# Lokal geliştirmede boş bırakılabilir (http://localhost:5000 varsayılan).
# Docker Compose'da http://backend:5000 (container network) kullanılır.
API_INTERNAL_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Production (Vercel) örneği ---
# NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
# API_INTERNAL_URL=https://your-api.up.railway.app
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# Detay: docs/DEPLOY.md

# Skin/statik görseller CDN (Cloudflare R2 vb.). Boşsa public/ klasöründen servis edilir.
# Trailing slash olmadan: https://cdn.example.com
# Detay: docs/CDN.md
NEXT_PUBLIC_CDN_URL=

# Sentry hata takibi (opsiyonel). Tanımlı değilse Sentry devre dışı kalır (hiçbir event gönderilmez).
# DSN: sentry.io → proje → Settings → Client Keys (DSN). Backend ve frontend için farklı proje/DSN önerilir.
# NEXT_PUBLIC_SENTRY_DSN: tarayıcıda çalışan (client-side) hataları yakalar, build anında bundle'a gömülür.
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN: Next.js server/edge tarafında (SSR, middleware, route handler) çalışan hataları yakalar.
SENTRY_DSN=

# Kaynak harita (source map) yükleme — opsiyonel, sadece Sentry panelinde okunabilir stack trace
# görmek istersen gerekli. Tanımsızsa build'i bloklamaz, sourcemap yükleme otomatik atlanır.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
