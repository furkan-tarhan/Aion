PORT=5000
# Lokal geliştirme: mongodb://localhost:27017/L3X4
# Docker Compose: mongodb://mongo:27017/L3X4 (compose dosyaları bunu otomatik ayarlar)
# Production (Railway): MongoDB Atlas — mongodb+srv://USER:PASS@cluster.../L3X4?... (bkz. docs/DEPLOY.md)
MONGODB_URI=mongodb://localhost:27017/L3X4

JWT_SECRET=change-me-to-a-random-secret
EMAIL_USER=
EMAIL_PASS=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
# Tek origin veya virgülle birden fazla (örn. https://loopskins.vercel.app,https://loopskins-git-main-xxx.vercel.app)
CORS_ORIGIN=http://localhost:3000

STEAM_API_KEY=

# Steam trade bot (opsiyonel) — ilan verirken item'ı otomatik emanete alıp satın alma sonrası
# otomatik teslim eder. Dördü de tanımlı değilse bot devre dışı kalır, akış tamamen manuele düşer
# (satıcı trade URL'ini kaydeder, teslimat elle yapılır — mevcut davranış).
# Bu, marketplace'in kendi Steam hesabı olmalı (ana/kişisel hesap DEĞİL) ve üzerinde Steam Guard
# Mobile Authenticator etkin olmalı. shared_secret/identity_secret'i almak için hesabı bir mobil
# authenticator aracıyla (örn. Steam Desktop Authenticator) bağlarken kaydedilen maFile'a bakın.
# UYARI: steamcommunity/steam-tradeoffer-manager paketlerinin bağımlılık zincirinde düzeltmesi
# olmayan güvenlik açıkları var (bkz. docs/PROJECT_STATUS.md) — bu yüzden bot ayrı, izole bir
# child process'te çalışır ve bu process'e MONGO_URI/JWT_SECRET gibi hiçbir sır aktarılmaz.
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
STEAM_BOT_SHARED_SECRET=
STEAM_BOT_IDENTITY_SECRET=

# iyzico sandbox/test API bilgileri — https://sandbox-merchant.iyzipay.com üzerinden alınır
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Bu email'lerle (virgülle ayrılmış) register/login olan kullanıcılar otomatik admin olur
ADMIN_EMAILS=

# Redis tabanlı rate limiting (opsiyonel). Tanımlı değilse in-memory rate limiting kullanılır
# (tek instance için yeterlidir). Docker Compose: redis://redis:6379 otomatik ayarlanır.
REDIS_URL=

# Loglama (bkz. backend/src/logger.ts)
# LOG_LEVEL: trace|debug|info|warn|error|fatal (varsayılan: dev'de debug, prod'da info)
LOG_LEVEL=
# LOG_TO_FILE: true/false — logs/app-*.log dosyasına günlük rotasyonlu yazma (varsayılan: sadece production'da true)
LOG_TO_FILE=

# Sentry hata takibi (opsiyonel). Tanımlı değilse Sentry devre dışı kalır (hiçbir event gönderilmez).
# DSN: sentry.io → proje → Settings → Client Keys (DSN)
SENTRY_DSN=

# Web Push (PWA) — opsiyonel. Tanımlı değilse push aboneliği 503 döner, in-app bildirimler çalışmaya devam eder.
# Anahtar üretmek için: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: veya https: URL (VAPID subject)
VAPID_SUBJECT=mailto:admin@example.com
